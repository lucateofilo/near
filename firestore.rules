rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(coupleId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Profilo utente (nome + avatar): leggibile da chiunque sia autenticato
    // conoscendo l'uid esatto (serve per mostrare il profilo del partner),
    // list vietato così nessuno può elencare tutti gli utenti.
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Codici di abbinamento: get ammesso solo conoscendo l'ID esatto (il codice stesso),
    // list vietato così nessuno può enumerare i codici esistenti.
    match /pairingCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update, delete: if false;

      match /settings/{uid} {
        allow read: if isMember(coupleId);
        allow write: if request.auth.uid == uid && isMember(coupleId);
      }

      match /schedule/{date} {
        allow read: if isMember(coupleId);
        allow write: if false; // scritto solo dallo script Node via firebase-admin (bypassa le rules)
      }

      match /photos/{photoId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.uid == request.auth.uid;
        allow update: if isMember(coupleId); // reazioni dell'altro partner
        allow delete: if false;
      }

      match /notes/{noteId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.uid == request.auth.uid;
        // unico update permesso: il destinatario (non l'autore) marca il bigliettino come letto
        allow update: if isMember(coupleId)
          && request.auth.uid != resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read, write: if isMember(coupleId);
      }

      match /trips/{tripId} {
        allow read, write: if isMember(coupleId);

        match /days/{dayIndex} {
          allow read, write: if isMember(coupleId);
        }
      }
    }
  }
}
